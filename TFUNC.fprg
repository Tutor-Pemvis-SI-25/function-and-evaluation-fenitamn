<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="TFUNSC"/>
        <attribute name="authors" value="Advan"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-18 09.15.38 PM"/>
        <attribute name="created" value="QWR2YW47REVTS1RPUC1LMlM2TkRVOzIwMjUtMTEtMTg7MDguMTQuNTkgUE07MjgzMw=="/>
        <attribute name="edited" value="QWR2YW47REVTS1RPUC1LMlM2TkRVOzIwMjUtMTEtMTg7MDkuMTUuMzggUE07MTsyOTQw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="namatugas, nim, matkul, dosen, deadline" type="String" array="True" size="10"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="9" direction="inc" step="1">
                <input variable="namatugas[i]"/>
                <input variable="nim[i]"/>
                <input variable="matkul[i]"/>
            </for>
            <call expression="addtask(namatugas,nim,matkul,dosen,deadline)"/>
        </body>
    </function>
    <function name="addtask" type="None" variable="">
        <parameters>
            <parameter name="namatugas" type="String" array="False"/>
            <parameter name="nim" type="String" array="False"/>
            <parameter name="matkul" type="String" array="False"/>
            <parameter name="dosen" type="String" array="False"/>
            <parameter name="deadline" type="String" array="False"/>
        </parameters>
        <body>
            <input variable="namatugas"/>
            <input variable="nim"/>
            <input variable="matkul"/>
            <input variable="dosen"/>
            <input variable="deadline"/>
            <declare name="namatugas, nim, matkul, dosen, deadline" type="String" array="False" size=""/>
        </body>
    </function>
</flowgorithm>
